@page "/counter/{initialCount:int?}"
@using blazor_hello.Components.Buttons
@rendermode InteractiveServer

<PageTitle>Counter</PageTitle>

@if (WithHeading)
{
    <br />
    <h1>@Heading</h1>
}

<p role="status">Current count: @currentCount</p>

<div class="mt-3">
    <ActionButton class="btn btn-success" OnClick="DecrementCount">-</ActionButton>
    <ActionButton class="btn btn-success" OnClick="IncrementCount">+</ActionButton>
</div>

@code {
    private int currentCount = 0;

    protected override void OnInitialized()
    {
        base.OnInitialized();
        currentCount = InitialCount;
    }

    [Parameter]
    public int InitialCount { get; set; }

    [Parameter]
    public string Heading { get; set; } = "Counter";

    [Parameter]
    public bool WithHeading { get; set; } = false;

    [Parameter]
    public int StepAmount { get; set; } = 1;

    private void DecrementCount(MouseEventArgs args) => currentCount -= StepAmount;
    private void IncrementCount() => currentCount += StepAmount;
}